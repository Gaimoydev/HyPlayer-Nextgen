<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
		<Nullable>annotations</Nullable>
		<UseUwp>true</UseUwp>
		<Platforms>x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<DefaultLanguage>zh-CN</DefaultLanguage>
		<LangVersion>preview</LangVersion>
		<EnableMsixTooling>true</EnableMsixTooling>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PublishAot Condition="'$(Configuration)' != 'Debug'">true</PublishAot>
		<DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
		<NoWarn>IL2026;IL3050</NoWarn>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
	</PropertyGroup>
	<ItemGroup>
	  <Content Include="Shaders\BackgroundShader.bin">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>
  <ItemGroup>
    <PackageReference Include="ALRC.Abstraction">
      <Version>1.3.0</Version>
    </PackageReference>
    <PackageReference Include="ALRC.Converters">
      <Version>1.3.2</Version>
    </PackageReference>
    <PackageReference Include="AsyncAwaitBestPractices">
      <Version>10.0.0</Version>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Labs.Uwp.Controls.TitleBar" Version="0.1.251217-build.2433" />
    <PackageReference Include="CommunityToolkit.Mvvm">
      <Version>8.4.2</Version>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Uwp.Animations">
      <Version>8.2.251219</Version>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Uwp.Behaviors">
      <Version>8.2.251219</Version>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Uwp.Controls.ColorPicker">
      <Version>8.2.251219</Version>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Uwp.Controls.Primitives">
      <Version>8.2.251219</Version>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Uwp.Controls.SettingsControls">
      <Version>8.2.251219</Version>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Uwp.Converters">
      <Version>8.2.251219</Version>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Uwp.Extensions">
      <Version>8.2.251219</Version>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Uwp.Media">
      <Version>8.2.251219</Version>
    </PackageReference>
    <PackageReference Include="F23.StringSimilarity">
      <Version>7.0.1</Version>
    </PackageReference>
    <PackageReference Include="HyPlayer.PlayCore.Abstraction">
      <Version>0.1.4</Version>
    </PackageReference>
    <PackageReference Include="LiteFM" Version="1.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection">
      <Version>10.0.8</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications">
      <Version>7.1.3</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.UI.Xaml">
      <Version>2.8.7</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Uwp.Managed">
      <Version>3.0.1</Version>
    </PackageReference>
    <PackageReference Include="QRCoder">
      <Version>1.8.0</Version>
    </PackageReference>
    <PackageReference Include="TagLibSharp">
      <Version>2.3.0</Version>
    </PackageReference>
    <PackageReference Include="Polly">
      <Version>8.6.6</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML">
      <Version>1.22.0</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HyPlayer.Frieren\HyPlayer.Frieren.csproj" />
    <ProjectReference Include="..\HyPlayer.NeteaseProvider\HyPlayer.NeteaseApi\HyPlayer.NeteaseApi.csproj" />
    <ProjectReference Include="..\HyPlayer.UWP.Chopin\HyPlayer.UWP.Chopin.csproj" />
    <ProjectReference Include="..\Impressionist\Impressionist\Impressionist.csproj" />
    <ProjectReference Include="..\Kawazu\Kawazu\Kawazu.csproj" />
    <ProjectReference Include="..\Microsoft.Gaming.XboxGameBar.Projection\Microsoft.Gaming.XboxGameBar.Projection.csproj" />
  </ItemGroup>
  <Target Name="BuildHyPlayerNative" BeforeTargets="AssignTargetPaths" Condition="'$(Platform)' == 'x64' Or '$(Platform)' == 'arm64'">
    <PropertyGroup>
      <HyPlayerNativePlatform Condition="'$(Platform)' == 'arm64'">ARM64</HyPlayerNativePlatform>
      <HyPlayerNativePlatform Condition="'$(Platform)' == 'x64'">x64</HyPlayerNativePlatform>
      <HyPlayerNativeDll>$(MSBuildThisFileDirectory)..\HyPlayer.Native\out\$(HyPlayerNativePlatform)\hyp_stretch.dll</HyPlayerNativeDll>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\HyPlayer.Native\HyPlayer.Native.vcxproj" Properties="Configuration=Release;Platform=$(HyPlayerNativePlatform)" RemoveProperties="RuntimeIdentifier;TargetFramework;SelfContained;PublishProfile;PublishDir;_IsPublishing" ContinueOnError="WarnAndContinue" />
    <ItemGroup Condition="Exists('$(HyPlayerNativeDll)')">
      <Content Include="$(HyPlayerNativeDll)" Link="hyp_stretch.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>true</Microsoft_AI_DirectML_SkipDebugLayerCopy>
    <Microsoft_AI_DirectML_SkipLibraryCopy>true</Microsoft_AI_DirectML_SkipLibraryCopy>
  </PropertyGroup>
  <Target Name="PublishDirectML" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(Platform)' == 'x64' Or '$(Platform)' == 'arm64'">
    <PropertyGroup>
      <HyPlayerDirectMLDir Condition="'$(Platform)' == 'x64'">$(Microsoft_AI_DirectML_Bin_Dir_Windows_x64)</HyPlayerDirectMLDir>
      <HyPlayerDirectMLDir Condition="'$(Platform)' == 'arm64'">$(Microsoft_AI_DirectML_Bin_Dir_Windows_Arm64)</HyPlayerDirectMLDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(HyPlayerDirectMLDir)' != '' And Exists('$(HyPlayerDirectMLDir)\DirectML.dll')">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'DirectML.dll'" />
      <ResolvedFileToPublish Include="$(HyPlayerDirectMLDir)\DirectML.dll" RelativePath="DirectML.dll" TargetPath="DirectML.dll" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="PublishHyPlayerNative" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="BuildHyPlayerNative" Condition="'$(Platform)' == 'x64' Or '$(Platform)' == 'arm64'">
    <ItemGroup Condition="Exists('$(HyPlayerNativeDll)')">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'hyp_stretch.dll'" />
      <ResolvedFileToPublish Include="$(HyPlayerNativeDll)" RelativePath="hyp_stretch.dll" TargetPath="hyp_stretch.dll" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
