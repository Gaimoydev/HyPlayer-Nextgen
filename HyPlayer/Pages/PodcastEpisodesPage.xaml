<Page
    x:Class="HyPlayer.Pages.PodcastEpisodesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls1="using:HyPlayer.Controls"
    NavigationCacheMode="Disabled">
    <Grid>
        <controls1:SongsList
            x:Name="SongContainer"
            IsSearchEnabled="True"
            LoadingText="正在加载单集…"
            Songs="{x:Bind Songs, Mode=OneWay}">
            <controls1:SongsList.ListHeader>
                <StackPanel Margin="24,24,24,96" Spacing="10">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="36"
                        FontWeight="Medium"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="PlayAllButton"
                            Click="PlayAll_Click"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE768;" />
                                <TextBlock Text="播放全部" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </controls1:SongsList.ListHeader>
        </controls1:SongsList>
    </Grid>
</Page>
