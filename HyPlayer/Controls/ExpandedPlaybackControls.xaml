<UserControl
    x:Class="HyPlayer.Controls.ExpandedPlaybackControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hyplayer="using:HyPlayer"
    xmlns:primitives="using:HyPlayer.Controls.Primitives"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1A808080" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#26808080" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Tapped="RootGrid_Tapped" DoubleTapped="RootGrid_DoubleTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <primitives:FluidBar x:Name="ProgressBar" Grid.Row="0" BarBrush="White" />
        <Grid Grid.Row="1" Margin="0,-2,0,0">
            <TextBlock
                x:Name="ElapsedText"
                Opacity="0.6"
                HorizontalAlignment="Left"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="White"
                Text="0:00" />
            <TextBlock
                x:Name="RemainingText"
                Opacity="0.6"
                HorizontalAlignment="Right"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="White"
                Text="-0:00" />
            <Grid x:Name="QualityHost" HorizontalAlignment="Center">
                <TextBlock
                    x:Name="QualityText"
                    CharacterSpacing="60"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="" />
                <Grid x:Name="QualityRevealHost" IsHitTestVisible="False" Visibility="Collapsed">
                    <Grid x:Name="QualityMaskSource">
                        <TextBlock
                            x:Name="QualityRevealText"
                            CharacterSpacing="60"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="过渡" />
                    </Grid>
                    <Border x:Name="QualityBloomHost" />
                    <Border x:Name="QualityFillHost" />
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,6,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BtnPlayMode"
                AutomationProperties.Name="播放顺序"
                Grid.Column="0"
                Width="36"
                Height="36"
                HorizontalAlignment="Left"
                Click="BtnPlayMode_Click"
                CornerRadius="18"
                Style="{StaticResource TransportButtonStyle}"
                ToolTipService.ToolTip="顺序播放">
                <FontIcon
                    x:Name="IconPlayMode"
                    FontSize="16"
                    Foreground="White"
                    Glyph="&#xE169;" />
            </Button>
            <Button
                x:Name="BtnPrevious"
                AutomationProperties.Name="上一首"
                ToolTipService.ToolTip="上一首"
                Grid.Column="1"
                Width="56"
                Height="56"
                Click="BtnPrevious_Click"
                CornerRadius="28"
                Style="{StaticResource TransportButtonStyle}">
                <FontIcon
                    x:Name="IconPrevious"
                    FontSize="26"
                    Foreground="White"
                    Glyph="&#xF8AC;" />
            </Button>
            <Button
                x:Name="BtnPlayPause"
                AutomationProperties.Name="播放/暂停"
                ToolTipService.ToolTip="播放/暂停"
                Grid.Column="2"
                Width="72"
                Height="72"
                Margin="20,0"
                Click="BtnPlayPause_Click"
                CornerRadius="36"
                Style="{StaticResource TransportButtonStyle}">
                <FontIcon
                    x:Name="IconPlayPause"
                    FontSize="38"
                    Foreground="White"
                    Glyph="&#xF5B0;" />
            </Button>
            <Button
                x:Name="BtnNext"
                AutomationProperties.Name="下一首"
                ToolTipService.ToolTip="下一首"
                Grid.Column="3"
                Width="56"
                Height="56"
                Click="BtnNext_Click"
                CornerRadius="28"
                Style="{StaticResource TransportButtonStyle}">
                <FontIcon
                    FontSize="26"
                    Foreground="White"
                    Glyph="&#xF8AD;" />
            </Button>
            <Button
                x:Name="BtnMore"
                AutomationProperties.Name="更多"
                Grid.Column="4"
                Width="36"
                Height="36"
                HorizontalAlignment="Right"
                CornerRadius="18"
                Style="{StaticResource TransportButtonStyle}"
                ToolTipService.ToolTip="更多">
                <FontIcon
                    FontSize="16"
                    Foreground="White"
                    Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="MoreFlyout" Opening="MoreFlyout_Opening" Placement="Top">
                        <MenuFlyoutItem x:Name="ItemLike" Click="ItemLike_Click" Text="喜欢">
                            <MenuFlyoutItem.Icon>
                                <FontIcon x:Name="ItemLikeIcon" Glyph="&#xE006;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="ItemPlaylist_Click" Text="播放列表">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE142;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ItemDesktopLyrics" Click="ItemDesktopLyrics_Click" Text="桌面歌词">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7F4;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="ItemSubscribe" Click="ItemSubscribe_Click" Text="收藏到歌单">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE1DA;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ItemDownload" Click="ItemDownload_Click" Text="下载">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE118;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ItemComment" Click="ItemComment_Click" Text="评论">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8F2;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ItemShare" Click="ItemShare_Click" Text="分享">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <Grid Grid.Row="3" Opacity="0.75">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                Margin="0,0,10,0"
                FontSize="14"
                Foreground="White"
                Glyph="&#xE993;" />
            <primitives:FluidBar x:Name="VolumeBar" Grid.Column="1" BarBrush="White" />
            <FontIcon
                Grid.Column="2"
                Margin="10,0,0,0"
                FontSize="14"
                Foreground="White"
                Glyph="&#xE995;" />
        </Grid>
    </Grid>
</UserControl>
